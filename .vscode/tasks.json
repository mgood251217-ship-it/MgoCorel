{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MgoCorel",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\import.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Install MgoCorel Addon",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\install-addon.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Uninstall MgoCorel Addon",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\install-addon.ps1",
                "-Uninstall"
            ],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build MgoCorel Addon",
            "type": "shell",
            "command": "node",
            "args": [
                "${workspaceFolder}\\scripts\\build-addon.mjs"
            ],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Install MgoCorel Addon",
            "dependsOn": [
                "Build MgoCorel Addon",
                "Install MgoCorel Addon"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}